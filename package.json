{
  "name": "float-search-next",
  "version": "4.3.0",
  "description": "Search in a floating modal, split, tab or window, with a quick switcher, filters and saved searches. A maintained continuation of Floating Search by Boninall.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "bun test && node --test tests/*.test.cjs",
    "lint": "eslint --max-warnings 0 .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test:unit": "bun test",
    "test:regression": "node --test tests/*.test.cjs",
    "test:e2e": "bun run build && wdio run ./test/wdio.conf.mts",
    "typecheck": "tsc --noEmit && tsc -p test"
  },
  "keywords": [],
  "author": "Hugo Haas",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.50",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "obsidian": "^1.12.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  },
  "dependencies": {
    "monkey-around": "^2.3.0",
    "safe-regex2": "^5.1.2"
  }
}
